{
  "name": "mapiii-assistente",
  "version": "0.2.0",
  "private": true,
  "description": "Protótipo de estudo (FIAP, Global Solution CitizenTech, case Citizen Assist AI): o mapa dos seus direitos.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "validar-kb": "tsx scripts/validar-kb.ts",
    "eval": "tsx eval/avaliar.ts",
    "auditar-perguntas": "tsx scripts/auditar-perguntas.ts",
    "verificar": "npm run typecheck && npm test && npm run validar-kb",
    "test:banco": "bash scripts/testar-banco.sh",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "conferir-links": "tsx scripts/conferir-links.ts",
    "testar-sptrans": "tsx scripts/testar-sptrans.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
