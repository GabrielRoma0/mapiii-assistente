# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.
# O .env.local é ignorado pelo git (*.local no .gitignore).

# --- Navegador (Vite): podem ir para o app, são públicos por definição ---
# URL do projeto Supabase (Project Settings → API).
VITE_SUPABASE_URL=
# Chave publicável (anon/publishable). A segurança vem do RLS das migrações, não desta chave.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Só nas Edge Functions (Supabase → Edge Functions → Secrets). NUNCA com prefixo VITE_ ---
# A chave secreta (service_role) só é usada pela função de apagar conta. Não vai para o navegador nem para o git.
# SUPABASE_SERVICE_ROLE_KEY=   (o Supabase já injeta nas Edge Functions; não precisa definir à mão)
# Chave da API da Anthropic, só para a camada de IA (desligada por padrão).
ANTHROPIC_API_KEY=

# --- Embarque Garantido (Fase 3, desligado por padrão) ---
# Só como segredo da Edge Function `onibus` (supabase secrets set SPTRANS_TOKEN=...). Nunca aqui com valor real.
# Chave do aplicativo cadastrado em https://www.sptrans.com.br/desenvolvedores/ ("Meus Aplicativos").
SPTRANS_TOKEN=
# Opcionais da função `onibus`:
# ONIBUS_ORIGENS=https://seu-dominio.exemplo   (origens que podem chamar a função; padrão: todas)
# ONIBUS_LIMITE_POR_MINUTO=30                 (pedidos por minuto por IP)
